SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_BACKEND_SECRET_KEY

# Generate independent random URL-safe values (at least 32 characters); server only.
STREAM_TOKEN_SECRET=
MEDIAMTX_GATEWAY_SECRET=
MEDIAMTX_PUBLISH_SECRET=
MEDIAMTX_HLS_SECRET=
HLS_PUBLIC_BASE_URL=http://10.0.2.2:8000/streams
MEDIAMTX_HLS_INTERNAL_URL=http://mediamtx:8888

# Explicit server-approved camera ranges only. Empty denies new RTSP destinations.
CAMERA_ALLOWED_CIDRS=
CAMERA_ALLOWED_PORTS=554,8554
CAMERA_ALLOW_LOOPBACK=false

# Optional private tmpfs shared by API and vision worker with the same UID, mode 0700.
# Leave empty to disable dashboard transport. Never expose this directory publicly.
VISION_DASHBOARD_DIRECTORY=
# Operator-only, scoped source approval registry; never ship camera URLs to Android.
VISION_SUBSTREAM_REGISTRY=

# Verified wheel context prepared before Docker builds; public artifacts only.
VISION_WHEELHOUSE=/tmp/camera-vision-wheels
